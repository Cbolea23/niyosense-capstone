# NiyoSense Production Environment Variables
# Copy this file to .env before starting docker-compose

# Django Security
DEBUG=False
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=*

# Neon PostgreSQL Database Connection URL
# Format: postgresql://[user]:[password]@[neon-endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_password@ep-cool-forest-a1b2c3d4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# CSRF Trusted Origins (comma-separated domains / tunnels)
CSRF_TRUSTED_ORIGINS=https://*.trycloudflare.com,https://*.ngrok-free.app,http://localhost:8000,http://127.0.0.1:8000
