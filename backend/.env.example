# NiyoSense Production Environment Variables
# Copy this file to .env before starting docker-compose (NEVER commit .env to Git)

# Django Security
DEBUG=False
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
OWNER_PASSKEY=replace-with-your-private-owner-passkey
ALLOWED_HOSTS=niyosense.me,www.niyosense.me,localhost,127.0.0.1

# PostgreSQL Database Connection URL (Render Managed PostgreSQL or Neon)
# Internal Render URL format (Recommended for Render Web Service):
# DATABASE_URL=postgresql://[user]:[password]@[dpg-xxx]:5432/[dbname]
# External Render / Neon URL format:
# DATABASE_URL=postgresql://[user]:[password]@[host]/[dbname]?sslmode=require
DATABASE_URL=

# CSRF Trusted Origins (comma-separated domains / tunnels)
CSRF_TRUSTED_ORIGINS=https://niyosense.me,https://*.niyosense.me,https://*.onrender.com,http://localhost:8000,http://127.0.0.1:8000

# Cloudinary Cloud Storage (Permanent Media Storage for Images & Audio)
# Set these in your Render Environment Variables dashboard (DO NOT commit real keys here)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=
